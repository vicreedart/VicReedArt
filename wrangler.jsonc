{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicreedart",
  "account_id": "96beea4cdf2cb1c69115c88264af1c01",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "vars": { "INQUIRIES_ENABLED": "false", "SITE_URL": "" },
  "ratelimits": [
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "901001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "901002",
      "simple": { "limit": 2, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
  "env": {
    "preview": {
      "name": "vicreedart-preview",
      "vars": { "INQUIRIES_ENABLED": "false", "SITE_URL": "" },
      "ratelimits": [
        {
          "name": "INQUIRY_RATE_LIMITER",
          "namespace_id": "901011",
          "simple": { "limit": 3, "period": 60 },
        },
        {
          "name": "EMAIL_RATE_LIMITER",
          "namespace_id": "901012",
          "simple": { "limit": 2, "period": 60 },
        },
      ],
    },
  },
}
