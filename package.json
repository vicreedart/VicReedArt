{
  "name": "vicreedart-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "predev": "npm run content",
    "dev": "next dev --hostname 127.0.0.1",
    "content": "node --experimental-strip-types scripts/prepare-content.ts",
    "build": "npm run content && next build && node scripts/postbuild.mjs",
    "build:production": "node scripts/build-production.mjs",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p studio/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run content && npm run lint && npm run typecheck && npm test && npm run build",
    "studio:seed": "node --experimental-strip-types scripts/seed-sanity.ts",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:production": "node scripts/deploy.mjs production",
    "studio:dev": "node scripts/studio.mjs dev",
    "studio:build": "node scripts/studio.mjs build",
    "studio:deploy": "node scripts/studio.mjs deploy"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@sanity/client": "8.6.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "6.15.0",
    "styled-components": "^6.1.19",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.8",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "@vercel/frameworks": {
      "js-yaml": "^3.15.2",
      "smol-toml": "^1.8.0"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  }
}
